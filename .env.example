# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Neon: pooled connection for the app, direct (unpooled) connection for migrations.
# The Neon ↔ Vercel integration sets both automatically.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require

# Auth.js. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Resend, for magic-link and invite emails. Leave AUTH_RESEND_KEY empty locally
# to print emails to the server console instead.
AUTH_RESEND_KEY=
EMAIL_FROM="PLT Quiz <no-reply@your-verified-domain.org>"

# Comma-separated Super Admin emails. Changing this requires a redeploy.
SUPER_ADMINS=you@example.org

# Public base URL, used in emailed links.
APP_URL=http://localhost:3000

# Keyed hash for respondent sessions and share links. REQUIRED in production.
# Generate with: openssl rand -hex 32. Never change it once respondents have used the quiz.
TOKEN_PEPPER=

# Used from a later phase (cron authentication).
CRON_SECRET=

# TEMPORARY: lets staff sign in with their email + this PIN while email sending
# isn't set up. Minimum 6 characters (longer is better). Remove before launch.
SECRET_PIN=

# Integration tests only: a throwaway database. Every table is truncated between tests.
TEST_DATABASE_URL=
